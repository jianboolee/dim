# 项目配置

APP_NAME=d-im
APP_DEFAULT_AVATAR=

# Server Configuration
API_SERVER_PORT=8080
WS_SERVER_PORT=9000
WS_HEARTBEAT_INTERVAL=60s
WS_PONG_TIMEOUT=75s
WS_WRITE_TIMEOUT=10s

# MongoDB Configuration
MONGODB_URI=mongodb://root:root@localhost:27017/?authSource=admin
MONGODB_DATABASE=x_im

# Redis Configuration
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT Configuration (HS256, managed by IM)
JWT_SECRET=change-me-to-a-long-random-string
# access token 有效期（time.ParseDuration 格式，如 1h、30m）
JWT_EXPIRE=1h
# refresh token 有效期（time.ParseDuration 格式，如 168h、168h）
JWT_REFRESH_EXPIRE=168h
# 绝对会话上限（time.ParseDuration 格式），自首次登录起超过此时间须重新从业务系统进入
JWT_MAX_SESSION=168h
# 单用户最多保留的活跃登录设备/会话数，超过后自动吊销最久未活跃的会话
JWT_MAX_ACTIVE_SESSIONS=10
JWT_ISSUER=d-im

# Business system integration
INTEGRATION_API_KEY=change-me-integration-key
IM_FRONTEND_BASE_URL=http://localhost:5173
IM_PUBLIC_BASE_URL=http://localhost:8080

# Group avatar generation
IM_GROUP_AVATAR_DIR=./storage/group-avatars
IM_GROUP_AVATAR_SIZE=240
IM_GROUP_AVATAR_KEEP_VERSIONS=3

# Aliyun OSS upload
OSS_ENDPOINT=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=
# Optional, for example: https://img.example.com
OSS_CUSTOM_DOMAIN=
OSS_DIRECTORY=uploads
