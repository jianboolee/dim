# 项目配置

APP_NAME=d-im
APP_DEFAULT_AVATAR=

# Server Configuration
API_SERVER_PORT=8080
WS_SERVER_PORT=9000

# MongoDB Configuration
MONGODB_URI=mongodb://root:root@localhost:27017/?authSource=admin
MONGODB_DATABASE=x_im

# Redis Configuration
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT Configuration (HS256, managed by IM)
JWT_SECRET=change-me-to-a-long-random-string
# access token 有效期（秒），建议 1800～3600（60=1分钟，3600=1小时，86400=24小时）
JWT_EXPIRE=3600
# 绝对会话上限（秒），自首次登录起超过此时间须重新从业务系统进入
JWT_MAX_SESSION=86400
JWT_ISSUER=d-im

# Business system integration
INTEGRATION_API_KEY=change-me-integration-key
IM_FRONTEND_BASE_URL=http://localhost:5173

# Aliyun OSS upload
OSS_ENDPOINT=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=
# Optional, for example: https://img.example.com
OSS_CUSTOM_DOMAIN=
OSS_DIRECTORY=uploads
