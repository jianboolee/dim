# 项目配置

# 项目名称
APP_NAME=x-im
# 默认头像地址
DEFAULT_AVATAR=

# Server Configuration
API_SERVER_PORT=8080
WS_SERVER_PORT=9000

# MongoDB Configuration
MONGODB_URI=mongodb://root:root@localhost:27017/?authSource=admin
MONGODB_DATABASE=x_im

# Redis Configuration
# REDIS_ADDR=localhost:6379
# REDIS_PASSWORD=
# REDIS_DB=0

# JWT Configuration
JWT_PUBLIC_KEY_PATH=./config/keys/public.pem
